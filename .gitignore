node_modules/
dist/
out/
coverage/
test-results/
playwright-report/

# dist/ mounted under the repository name, so the deployment check can drive the
# subpath build the Pages workflow publishes
_site-serve/

.env
.env.*

.DS_Store
.vscode/
.idea/

# Downloaded topo tiles — large binaries, fetched via npm run fetch:tiles
data/tiles/*.hgt
data/tiles/*.hgt.gz

# Overture parquet footers cached by npm run fetch:peaks
data/overture/

# Field-site packages built by npm run site:package — tens of MB of mosaicked
# radar, rebuilt from sites/<id>.json and data/tiles/
data/sites/

# Agent scratch space — never committed
scratch/

# Expo dev-server + build caches
mobile/.expo/

# Expo prebuild output. `npx expo run:ios` generates these native projects from
# app.json; they are build artefacts, not sources, and regenerate on demand.
mobile/ios/
mobile/android/

# Sensor capture bundles from a phone session. A bundle records where someone
# stood and when, and travels only by the human's own action to their own
# account (AGENTS.md, "Captures from the phone"). npm run check:privacy fails on
# any file under either directory, so a `git add -f` does not get past it.
captures/
bundles/
